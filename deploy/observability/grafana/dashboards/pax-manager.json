{
  "uid": "pax-manager",
  "title": "Pax Manager",
  "tags": ["pax"],
  "schemaVersion": 41,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "API route",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
        "query": "label_values(pax_http_requests_total{job=\"pax-manager\"}, route)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Manager scrape status",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"pax-manager\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "Down", "color": "red"},
                "1": {"text": "Up", "color": "green"}
              }
            }
          ]
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API request rate",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pax_http_requests_total{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "Requests"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API server error rate",
      "description": "HTTP 5xx responses as a fraction of requests.",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 15, "y": 0, "w": 9, "h": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(pax_http_requests_total{job=\"pax-manager\", route=~\"$route\", status=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(pax_http_requests_total{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval]))) / sum(rate(pax_http_requests_total{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API request latency",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 0, "y": 7, "w": 24, "h": 10},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pax_http_request_duration_seconds_bucket{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pax_http_request_duration_seconds_bucket{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    }
  ]
}
