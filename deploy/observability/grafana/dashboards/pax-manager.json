{
  "uid": "pax-manager",
  "title": "Pax Manager",
  "tags": ["pax"],
  "schemaVersion": 41,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "API route",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
        "query": "label_values(pax_http_requests_total{job=\"pax-manager\"}, route)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {"text": ["All"], "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Manager scrape status",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"pax-manager\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "Down", "color": "red"},
                "1": {"text": "Up", "color": "green"}
              }
            }
          ]
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API request rate",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pax_http_requests_total{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "Requests"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API server error rate",
      "description": "HTTP 5xx responses as a fraction of requests.",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 15, "y": 0, "w": 9, "h": 7},
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(pax_http_requests_total{job=\"pax-manager\", route=~\"$route\", status=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(pax_http_requests_total{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval]))) / sum(rate(pax_http_requests_total{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API request latency",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 0, "y": 7, "w": 24, "h": 10},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pax_http_request_duration_seconds_bucket{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pax_http_request_duration_seconds_bucket{job=\"pax-manager\", route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 5,
      "type": "row",
      "title": "Manager resources",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 17, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Process CPU",
      "description": "100% represents one logical CPU.",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 0, "y": 18, "w": 8, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"pax-manager\"}[$__rate_interval])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Process memory",
      "description": "Resident memory includes the Go heap and other process memory.",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 8, "y": 18, "w": 8, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"pax-manager\"}",
          "legendFormat": "Resident memory"
        },
        {
          "refId": "B",
          "expr": "go_memstats_heap_alloc_bytes{job=\"pax-manager\"}",
          "legendFormat": "Go heap allocated"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Go goroutines",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 16, "y": 18, "w": 8, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=\"pax-manager\"}",
          "legendFormat": "Goroutines"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Open WebSockets",
      "description": "Concurrent control, agent, and client WebSocket connections.",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 0, "y": 26, "w": 24, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "pax_websocket_connections{job=\"pax-manager\"}",
          "legendFormat": "{{kind}}"
        },
        {
          "refId": "B",
          "expr": "sum(pax_websocket_connections{job=\"pax-manager\"})",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}}
    },
    {
      "id": 10,
      "type": "row",
      "title": "home_dev resources",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 34, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Host scrape status",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 0, "y": 35, "w": 6, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"pax-home-dev\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "Down", "color": "red"},
                "1": {"text": "Up", "color": "green"}
              }
            }
          ]
        }
      },
      "options": {"colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Host CPU",
      "description": "Non-idle time includes I/O wait. Both are averaged across logical CPUs.",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 6, "y": 35, "w": 9, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"pax-home-dev\", mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "Non-idle"
        },
        {
          "refId": "B",
          "expr": "avg by (instance) (rate(node_cpu_seconds_total{job=\"pax-home-dev\", mode=\"iowait\"}[$__rate_interval]))",
          "legendFormat": "I/O wait"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Host memory used",
      "description": "Total memory minus Linux MemAvailable, as a fraction of total memory.",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 15, "y": 35, "w": 9, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes{job=\"pax-home-dev\"} / node_memory_MemTotal_bytes{job=\"pax-home-dev\"}",
          "legendFormat": "Used"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Filesystem usage",
      "description": "Fraction of space unavailable to unprivileged users, including reserved blocks.",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 0, "y": 43, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{job=\"pax-home-dev\", mountpoint=~\"/|/srv/bulk\"} / node_filesystem_size_bytes{job=\"pax-home-dev\", mountpoint=~\"/|/srv/bulk\"}",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Filesystem space available",
      "datasource": {"type": "prometheus", "uid": "pax-prometheus"},
      "gridPos": {"x": 12, "y": 43, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"pax-home-dev\", mountpoint=~\"/|/srv/bulk\"}",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}}
    }
  ]
}
