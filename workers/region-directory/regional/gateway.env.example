# One file per region. Keep secrets outside version control.
PAX_REGION=hk
DIRECTORY_AUTHORITY_REGION=us
US_PUBLIC_ORIGIN=https://us.example.com
HK_PUBLIC_ORIGIN=https://hk.example.com
REGIONAL_ENTRY_ORIGIN=https://us.example.com
DIRECTORY_PEER_URL=https://us.example.com
REGIONAL_MANAGER_URL=http://127.0.0.1:9879
REGIONAL_CONSOLE_URL=http://127.0.0.1:3000
DIRECTORY_DATABASE_URL=postgresql://gateway:REPLACE@127.0.0.1:5432/pax_directory
DIRECTORY_REPLICATION_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
REGION_PROVISIONING_SECRET=REPLACE_WITH_THIS_REGIONS_MANAGER_SECRET
WORKOS_COOKIE_PASSWORD=REPLACE_WITH_RANDOM_SESSION_SECRET
WORKOS_API_KEY=REPLACE
WORKOS_CLIENT_ID=REPLACE
PORT=8080
LISTEN_HOST=127.0.0.1
# Enable only after importing and comparing both directory copies.
REGIONAL_DIRECTORY_READY=false
