FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY src ./src
RUN npm run build:regional && npm prune --omit=dev --ignore-scripts

FROM node:24-alpine
ENV NODE_ENV=production LISTEN_HOST=0.0.0.0 PORT=8080
WORKDIR /app
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist-regional ./dist-regional
USER node
EXPOSE 8080
CMD ["node", "dist-regional/gateway.mjs"]
